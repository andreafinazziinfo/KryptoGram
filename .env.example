# ==============================================================================
# KryptoGram v1.0 — Sovereign Environment Configuration
# ==============================================================================

# Pepper crittografico d'infrastruttura (256-bit hex o stringa ad alta entropia).
# IMPORTANTE: Conservare SOLO in questo ambiente/HSM e MAI nel database o nel codice!
KRYPTOGRAM_PEPPER=change_this_to_a_secret_32_bytes_random_hex_string_for_production

# Profilo di derivazione KDF predefinito: desktop (256MB) o mobile (64MB)
KRYPTOGRAM_DEFAULT_PROFILE=desktop

# Dimensione padding fisso predefinito in byte (difesa contro traffic analysis)
KRYPTOGRAM_DEFAULT_PADDING=4096

# ==============================================================================
# CycleLab Terminal Integration
# ==============================================================================
CYCLELAB_MASTER_PASSPHRASE=YourCycleLabMasterVaultSecretPassphrase2026!
CYCLELAB_ENCLAVE_ENVIRONMENT=production

# ==============================================================================
# OmniRoute AI Gateway Keystore (Opzionale / Vault Cifrato)
# ==============================================================================
# Le chiavi API dei vari provider possono essere gestite tramite il Vault protetto
# di KryptoGram prima di essere iniettate nella dashboard di OmniRoute.
OMNIROUTE_HOST=http://localhost:20128
OMNIROUTE_API_KEY=sk-omniroute-local-token
